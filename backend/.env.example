# ============================================================
# Banned Books Hub — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files. This .env.example file is safe to commit.
# See docs/env-vars.md for full documentation of every variable.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# MariaDB / MySQL connection details.
# For Railway: copy from the MariaDB service Variables tab.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=banned_books_local
DB_USER=root
DB_PASSWORD=

# ── Server ───────────────────────────────────────────────────
# HTTP port the backend listens on.
# Railway sets PORT automatically — do not override it in Railway environments.
PORT=3001

# ── CORS / Origin ────────────────────────────────────────────
# Hostname of the frontend (no protocol). Used to build the CORS allow-list.
# Local example: localhost:5173
# Railway example: banned-books-frontend-dev.up.railway.app
FRONTEND_URL=localhost:5173

# Protocol for constructing the CORS origin. Use "http" locally, "https" on Railway.
URL_PREFIX=http

# Railway-assigned public domain for this backend service (no protocol).
# Used for self-referencing URLs. Leave as localhost:PORT for local development.
RAILWAY_PUBLIC_DOMAIN=localhost:3001

# ── Authentication ────────────────────────────────────────────
# Admin panel credentials. Use strong, unique values per environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Secret used to sign and verify JWT tokens.
# Must be a long random string (min 32 characters). MUST be unique per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Session secret (carry-forward; verify whether actively used in current code).
SESSION_SECRET=

# ── Object Storage (MinIO) ────────────────────────────────────
# One shared MinIO client (utils/config.ts), used by both the image proxy
# route (imageRouter.ts) and the presigned-URL cache (minioCache.ts).

# Full URL (including protocol) to the MinIO bucket endpoint.
# Development bucket: https://bucket-development-d7ab.up.railway.app
# Production bucket:  https://bucket-production-70f9.up.railway.app
MINIO_URL=https://bucket-development-d7ab.up.railway.app

# Name of the S3 bucket within the MinIO service. Optional — defaults to "book-images".
MINIO_BUCKET_NAME=book-images

# MinIO access key and secret key.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Cache (Redis) ─────────────────────────────────────────────
# Redis connection URL.
# Local: redis://localhost:6379
# Railway: copy from the Redis service Variables tab (typically redis://...)
REDIS_URL=redis://localhost:6379

# ── Database Migrations ───────────────────────────────────────
# Configuration for the automatic database migration system.
# See docs/MIGRATIONS.md for complete documentation.

# Timeout (in seconds) for each individual migration execution.
# Default: 300 (5 minutes). Increase for large backfill operations.
MIGRATION_TIMEOUT=300

# MariaDB version (for compatibility checks during validation).
# Used to validate that migration SQL is compatible with the target database version.
# Examples: 10.4, 10.5, 10.6
DB_VERSION=10.4

# Skip migrations during startup (useful for local development or testing).
# Set to "true" to disable automatic migrations.
# Default: false (migrations enabled)
SKIP_MIGRATIONS=false
