# ============================================================
# Banned Books Hub — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files. This .env.example file is safe to commit.
# See docs/env-vars.md for full documentation of every variable.
# ============================================================

# ── API Connection ────────────────────────────────────────────
# Backend hostname WITHOUT protocol (Vite prepends the protocol from VITE_URL_PREFIX).
# Local example:   localhost:3001
# Railway example: banned-books-backend-dev.up.railway.app
VITE_API_URL=localhost:3001

# Protocol for API requests. Use "http" locally, "https" on Railway.
VITE_URL_PREFIX=http

# ── Human Verification (Cloudflare Turnstile) ─────────────────
# PUBLIC site key for the verification widget on the suggest and contact forms.
# The matching secret key belongs in the backend only (TURNSTILE_SECRET_KEY).
# Local testing: Cloudflare test site key 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
